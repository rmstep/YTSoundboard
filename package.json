{
  "name": "ytsoundboard",
  "version": "1.0.0",
  "description": "Hotkey soundboard that mixes into a virtual microphone and your speakers, fed by a YouTube clipper Chrome extension.",
  "author": "YTSoundboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node assets/make-icons.js",
    "tools": "node scripts/fetch-tools.js",
    "extension-zip": "node scripts/pack-extension.js",
    "streamdeck": "node scripts/pack-streamdeck.js",
    "release": "node scripts/fetch-tools.js && node scripts/pack-streamdeck.js && electron-builder --win nsis --publish always && node scripts/pack-extension.js",
    "dist": "node scripts/fetch-tools.js && node scripts/pack-streamdeck.js && electron-builder --win nsis && node scripts/pack-extension.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.ytsoundboard.app",
    "productName": "YTSoundboard",
    "directories": {
      "output": "dist"
    },
    "publish": { "provider": "github", "owner": "rmstep", "repo": "YTSoundboard" },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-tools",
        "to": "bin",
        "filter": [
          "*.exe",
          "*.txt",
          "*.streamDeckPlugin"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "YTSoundboard"
    }
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
