{
  "manifest_version": 3,
  "name": "YTSoundboard Clipper",
  "version": "1.1.1",
  "description": "Clip YouTube moments into hotkey sounds. Needs the free YTSoundboard app: github.com/rmstep/YTSoundboard-releases",
  "host_permissions": ["http://127.0.0.1:38917/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
